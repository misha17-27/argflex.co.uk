Thumbs.db
.DS_Store
desktop.ini
*.log
.vscode/
.idea/

# raw API dumps and crawl output - regenerate with .data/build_data.py
.data/*.json
.data/var/
.data/varids*.txt
storage/orders/*.json
.data/live_html/
.data/_seo_urls.txt

# Runtime state and secrets. Deny everything under storage/ and name the few
# files that ARE part of the source, rather than listing what to exclude:
# storage/app.key was committed and pushed the moment it was created, because
# the list did not know about a file that had not been invented yet. A rule
# that has to be updated for every new secret will be wrong again.
storage/*
!storage/.htaccess
!storage/.gitkeep
!storage/orders/
storage/orders/*
!storage/orders/.gitkeep
!storage/pending/
storage/pending/*
!storage/pending/.gitkeep

# Python leaves these next to the check scripts
__pycache__/
*.pyc

# Somewhere to keep a key while it is being pasted in, without it becoming a
# commit. A Stripe secret is shown once at creation, so it gets saved to a
# file in a hurry — and a hurry plus `git add -A` is how a live key reaches
# a public repository. GitHub's push protection caught one here; this is so
# it never gets that far again.
stripe/
paypal/
*.key.txt
**/keys.txt
**/New Text Document.txt
