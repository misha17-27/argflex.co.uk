# ---------------------------------------------------------------- routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # One canonical address. The rankings this migration protects belong to
    # https://argflex.co.uk — every other spelling that also answers splits
    # the signal, so www and plain http are sent there permanently.
    #
    # Both rules are scoped to the real domain deliberately. A staging copy on
    # a subdomain has no certificate until the host issues one, and forcing it
    # to https there would leave it unreachable for no gain: that copy is
    # noindex either way, so the scheme does not matter until the domain moves.
    # If your host terminates TLS upstream it sets X-Forwarded-Proto, which the
    # second condition reads.
    RewriteCond %{HTTP_HOST} ^(www\.)?argflex\.co\.uk$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.argflex\.co\.uk$ [NC]
    RewriteRule ^ https://argflex.co.uk%{REQUEST_URI} [R=301,L]

    # On any host that is not the real shop, robots.txt comes from PHP so it
    # can say Disallow: / — a staging copy serves identical pages and must
    # never reach the index.
    RewriteCond %{HTTP_HOST} !^(www\.)?argflex\.co\.uk$ [NC]
    RewriteRule ^robots\.txt$ index.php [L]

    # The old WordPress, moved aside on the day of the switch rather than
    # deleted — sensibly, because it is the way back. But it was moved INSIDE
    # the document root, so the server went on executing every PHP file in it:
    # /old/wp-admin/ answered, /old/readme.html served, and the whole of a
    # WordPress that will never be patched again sat one URL away from the
    # shop. Refused here, before anything in it can run.
    #
    # This is cover, not the fix. Move the folder out of the web root — one
    # level up, beside it rather than inside it — and it stops being reachable
    # at all rather than relying on a rule staying in this file.
    RewriteRule ^old(?:/|$) - [F,L]

    # WordPress paged its listings; this site fits them on one page. Those
    # addresses are linked from the old site and are in the index, so they are
    # sent to the listing itself rather than left to 404 — or, worse, to
    # answer 200 with page one's content and declare themselves canonical,
    # which is what /shop/page/2/ did.
    RewriteRule ^product-category/(.+?)/page/[0-9]+/?$ /product-category/$1/ [R=301,L]
    RewriteRule ^(shop|length|inner-diameter)/page/[0-9]+/?$ /$1/ [R=301,L]
    RewriteRule ^(length|inner-diameter)/([^/]+)/page/[0-9]+/?$ /$1/$2/ [R=301,L]

    # WordPress's blog taxonomy. Every one of the twenty articles links to both
    # category archives and to the author archive at the foot of the post, so
    # the switch turned sixty internal links into 404s at once — which reads to
    # Search Console as a fault with the site rather than a few dead ends.
    #
    # Here rather than in the redirects list under Settings -> Advanced,
    # because that list lives in the stored settings and a shop already running
    # keeps its own copy: anything added to the shipped defaults never reaches
    # it. These have to hold for ever, so they travel with the code.
    RewriteRule ^category/[^/]+/?$ /blog/ [R=301,L]
    RewriteRule ^author/[^/]+/?$ /blog/ [R=301,L]

    # Serve real files and directories as they are
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php

# ------------------------------------------------------------ compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ---------------------------------------------------------------- caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # CSS and JS are versioned with ?v= so they can be cached hard
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------- misc
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# Keep dotfiles private. FilesMatch only ever sees the last part of the
# path, so it catches /.gitignore but not /.data/products.json — the folders
# carry their own deny file as well.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

ErrorDocument 404 /index.php
