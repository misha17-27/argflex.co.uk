# ---------------------------------------------------------------- routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # One canonical address. The rankings this migration protects belong to
    # https://argflex.co.uk — every other spelling that also answers splits
    # the signal, so www and plain http are sent there permanently.
    #
    # If your host terminates TLS upstream it will set X-Forwarded-Proto;
    # if it has no certificate yet, comment the first pair out or you will
    # loop.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # On any host that is not the real shop, robots.txt comes from PHP so it
    # can say Disallow: / — a staging copy serves identical pages and must
    # never reach the index.
    RewriteCond %{HTTP_HOST} !^(www\.)?argflex\.co\.uk$ [NC]
    RewriteRule ^robots\.txt$ index.php [L]

    # Serve real files and directories as they are
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php

# ------------------------------------------------------------ compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ---------------------------------------------------------------- caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # CSS and JS are versioned with ?v= so they can be cached hard
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------- misc
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# Keep dotfiles private. FilesMatch only ever sees the last part of the
# path, so it catches /.gitignore but not /.data/products.json — the folders
# carry their own deny file as well.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

ErrorDocument 404 /index.php
